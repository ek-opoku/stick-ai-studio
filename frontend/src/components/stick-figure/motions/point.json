{
  "id": "point",
  "name": "Point",
  "durationMs": 900,
  "loop": "once",
  "keyframes": [
    {
      "timeMs": 0,
      "label": "ready",
      "easing": "smoothstep",
      "pose": {
        "body": { "x": 0, "y": 0 },
        "head": { "tilt": 0 },
        "joints": {
          "torso": 0,
          "leftShoulder": 8,
          "leftElbow": 10,
          "rightShoulder": -8,
          "rightElbow": 10,
          "leftHip": -2,
          "leftKnee": 4,
          "rightHip": 2,
          "rightKnee": -4
        }
      }
    },
    {
      "timeMs": 350,
      "label": "extend",
      "easing": "easeInOut",
      "pose": {
        "body": { "x": 2, "y": -1 },
        "head": { "tilt": -5 },
        "joints": {
          "torso": -5,
          "leftShoulder": 12,
          "leftElbow": 18,
          "rightShoulder": -38,
          "rightElbow": -54,
          "leftHip": -3,
          "leftKnee": 4,
          "rightHip": 3,
          "rightKnee": -4
        }
      }
    },
    {
      "timeMs": 900,
      "label": "hold",
      "pose": {
        "body": { "x": 2, "y": -1 },
        "head": { "tilt": -7 },
        "joints": {
          "torso": -6,
          "leftShoulder": 10,
          "leftElbow": 18,
          "rightShoulder": -44,
          "rightElbow": -60,
          "leftHip": -3,
          "leftKnee": 4,
          "rightHip": 3,
          "rightKnee": -4
        }
      }
    }
  ]
}
